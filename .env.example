# =============================================================================
# WB FBS Manager — Environment Variables Template
# Скопируйте в .env и заполните значения
# =============================================================================

# Application
APP_NAME="WB FBS Manager"
APP_VERSION="1.0.0"
DEBUG=false
SECRET_KEY=your-very-secret-key-change-this-in-production

# Database Credentials
POSTGRES_USER=wbfbs
POSTGRES_PASSWORD=wbfbs_password
POSTGRES_DB=wbfbs
DATABASE_URL=postgresql+asyncpg://wbfbs:wbfbs_password@postgres:5432/wbfbs
DATABASE_URL_SYNC=postgresql://wbfbs:wbfbs_password@postgres:5432/wbfbs

# Redis (Celery broker + cache)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Security & Authentication
JWT_SECRET_KEY=your-jwt-secret-key-change-this
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Bootstrap Admin Account
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin_password
ADMIN_EMAIL=admin@example.com

# Encryption key for storing WB/CZ tokens in DB
ENCRYPTION_KEY=jK4hdZuYiftat9StWo41NqsmE9HHzxj5I6tMNq4LgnA=

# Celery Beat schedule (seconds)
WB_POLLING_INTERVAL=60
ARCHIVE_PROCESS_HOUR=3
TOKEN_REFRESH_INTERVAL=1800

# =============================================================================
# SELLER-SPECIFIC SETTINGS (stored per-seller in DB, these are defaults)
# =============================================================================

# Wildberries API (per seller — stored in DB)
# WB_API_TOKEN=your_wb_api_token_here

# Честный знак / True API
# CZ_INN=your_inn_here
# CZ_API_TOKEN=your_cz_token_here
# CZ_API_BASE_URL=https://ismp.crpt.ru
# CZ_API_SANDBOX_URL=https://demo.crpt.ru
# CZ_USE_SANDBOX=false

# КриптоПро settings
CRYPTOPRO_BIN_PATH=/usr/local/bin/cryptcp
CRYPTOPRO_CERT_THUMBPRINT=your_cert_thumbprint_here

# Telegram Bot (per seller — stored in DB)
# TELEGRAM_BOT_TOKEN=your_bot_token_here
# TELEGRAM_ADMIN_CHAT_ID=your_chat_id_here

# Flower (Celery monitoring)
FLOWER_PORT=5555
FLOWER_BASIC_AUTH=admin:admin_password